{
  "name": "cheer-and-chores",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:sync && npm run build:qr",
    "test": "node tests/app.test.mjs && node tests/qr.test.mjs",
    "emulator": "firebase emulators:start --only firestore --project demo-cheer",
    "test:sync": "node tests/sync.test.mjs",
    "build:sync": "esbuild src/sync.js --bundle --format=esm --minify --platform=browser --target=es2020,safari15 --legal-comments=eof --outfile=sync.js",
    "build:qr": "esbuild src/qr.js --bundle --format=esm --minify --platform=browser --target=es2020,safari15 --legal-comments=eof --outfile=qr.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0",
    "jsdom": "24.1.3",
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4"
  }
}
